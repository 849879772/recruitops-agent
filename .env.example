# Core runtime
RECRUITOPS_ENV=development
RECRUITOPS_DATABASE_URL=postgresql+psycopg://recruitops:recruitops@localhost:5433/recruitops
RECRUITOPS_API_HOST=127.0.0.1
RECRUITOPS_API_PORT=8010
RECRUITOPS_API_TOKEN=
RECRUITOPS_WRITE_ENABLED=false
RECRUITOPS_CHECKPOINT_MODE=memory
RECRUITOPS_BACKUP_ROOT=.data/backups

# Automation and crawling
RECRUITOPS_AUTOMATION_ENABLED=true
RECRUITOPS_DISCOVERY_ENABLED=true
RECRUITOPS_CRAWL_COMPANY_TIMEOUT_SECONDS=300
RECRUITOPS_OFFLINE_RECONCILIATION_ENABLED=true
RECRUITOPS_OFFLINE_GRACE_RUNS=2
RECRUITOPS_OFFLINE_GRACE_DAYS=3

# Unified DeepSeek Flash model. Keep disabled until an API key is configured.
RECRUITOPS_LLM_ENABLED=false
RECRUITOPS_JOB_ANALYSIS_ENABLED=false
RECRUITOPS_LLM_API_KEY=
RECRUITOPS_MODEL_API_BASE_URL=https://api.deepseek.com
RECRUITOPS_LLM_TOOL_CALLING_ENABLED=true
RECRUITOPS_LLM_AGENT_MAX_TOKENS=1200
RECRUITOPS_LLM_TIMEOUT_SECONDS=45
RECRUITOPS_LLM_MAX_TOKENS=400
RECRUITOPS_LLM_MATCHING_MAX_TOKENS=2000
RECRUITOPS_LLM_MATCHING_THINKING_ENABLED=false
RECRUITOPS_MATCH_MAX_CONCURRENCY=4
RECRUITOPS_MATCH_CHECKPOINT_BATCH_SIZE=25
RECRUITOPS_VISION_ENABLED=true
RECRUITOPS_VISION_MAX_IMAGE_BYTES=6291456
RECRUITOPS_VISION_TIMEOUT_SECONDS=45

# Optional Codex App Server harness
RECRUITOPS_CODEX_RUNTIME_ENABLED=false
RECRUITOPS_CODEX_CLI_VERSION=0.149.0
RECRUITOPS_CODEX_COMMAND=
RECRUITOPS_CODEX_HOME=.data/codex-home
RECRUITOPS_CODEX_STARTUP_TIMEOUT_SECONDS=15
RECRUITOPS_CODEX_MODEL_PROVIDER_ID=deepseek
RECRUITOPS_CODEX_MODEL_API_KEY_ENV=RECRUITOPS_LLM_API_KEY
RECRUITOPS_CODEX_REASONING_EFFORT=high
RECRUITOPS_CODEX_TRACE_PATH=.data/codex-traces.jsonl

# Optional local or remote embedding service
RECRUITOPS_EMBEDDING_ENDPOINT=
RECRUITOPS_EMBEDDING_API_KEY=
RECRUITOPS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RECRUITOPS_EMBEDDING_DIMENSION=1024

# Optional recruitment mailbox. Prefer an application password.
RECRUITOPS_MAIL_ENABLED=false
RECRUITOPS_MAIL_IMAP_HOST=imap.example.com
RECRUITOPS_MAIL_IMAP_PORT=993
RECRUITOPS_MAIL_IMAP_USERNAME=
RECRUITOPS_MAIL_IMAP_PASSWORD=
RECRUITOPS_MAIL_IMAP_MAILBOX=INBOX

# Optional proxy used inside the API container
RECRUITOPS_CONTAINER_HTTP_PROXY=
RECRUITOPS_CONTAINER_HTTPS_PROXY=

